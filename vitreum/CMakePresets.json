{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC · Debug · x64",
      "description": "MSVC, C++20, Ninja, depuración",
      "inherits": "windows-ninja-base",
      "environment": {
        "CC": "cl",
        "CXX": "cl"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC · Release · x64",
      "description": "MSVC, C++20, Ninja, optimizado",
      "inherits": "windows-ninja-base",
      "environment": {
        "CC": "cl",
        "CXX": "cl"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clangcl-debug",
      "displayName": "Clang-cl · Debug · x64",
      "description": "Clang-cl de Visual Studio, ABI MSVC, C++20",
      "inherits": "windows-ninja-base",
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "clangcl-release",
      "displayName": "Clang-cl · Release · x64",
      "description": "Clang-cl de Visual Studio, ABI MSVC, C++20, optimizado",
      "inherits": "windows-ninja-base",
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    }
  ]
}
